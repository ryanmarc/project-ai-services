# Multi-stage build for mcp-poc
FROM registry.access.redhat.com/ubi9/ubi:9.7 AS builder

# Install Node.js 24 using DNF module
RUN dnf module enable nodejs:24 -y && \
    dnf install nodejs -y && \
    dnf clean all

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./
COPY tsconfig.json ./

# Install dependencies (both dev and production needed for build)
RUN npm ci

# Copy source code
COPY src ./src

# Build the application
RUN npm run build

# Production stage
FROM registry.access.redhat.com/ubi9/ubi:9.7

# Install Node.js 24 runtime using DNF module
RUN dnf module enable nodejs:24 -y && \
    dnf install nodejs -y && \
    dnf clean all

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Copy node_modules from builder (includes all dependencies needed at runtime)
COPY --from=builder /app/node_modules ./node_modules

# Copy built application from builder stage
COPY --from=builder /app/dist ./dist

# Expose port 3131
EXPOSE 3131

# Set environment variables
ENV PORT=3131
ENV HOST=0.0.0.0
ENV NODE_ENV=production

# Run the application
CMD ["node", "dist/index.js"]